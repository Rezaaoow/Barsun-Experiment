[Unit]
Description=Barsan application, backup age and disk-space checks
After=barsan-production.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/barsan/health.py
TimeoutStartSec=15
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/barsan-operations
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=128M
LogNamespace=barsan
